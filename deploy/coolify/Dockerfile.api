# Node >=20 is required for the service example's npx-based MCP tools.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 python3-venv python3-dev build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/agentscope-venv
ENV PATH="/opt/agentscope-venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /srv/agentscope
COPY . .
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir \
       -e ".[service,storage-redis,channel,vdb-qdrant,rag]"

WORKDIR /srv/agentscope/examples/agent_service
EXPOSE 8000
CMD ["python", "main.py"]

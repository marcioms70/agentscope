FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV HUSKY=0
RUN corepack enable && corepack prepare pnpm@10.21.0 --activate
COPY examples/web_ui/ ./
RUN pnpm install --frozen-lockfile \
    && pnpm --filter frontend build

FROM nginx:stable-alpine
RUN apk add --no-cache apache2-utils
COPY deploy/coolify/start-web.sh /usr/local/bin/start-web.sh
RUN chmod 755 /usr/local/bin/start-web.sh
COPY deploy/coolify/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
CMD ["/usr/local/bin/start-web.sh"]
